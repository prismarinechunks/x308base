"UnlitGeneric"
{
	"$basetexture" "undertale/miss"
	"$alphatest"   "1"
   "%compilepassbullets" "1"
   "Proxies"
   {
      "AnimatedTexture"
      {
         "animatedtexturevar" "$basetexture"
         "animatedtextureframenumvar" "$frame"
         "animatedtextureframerate" 1
      }
   }
}