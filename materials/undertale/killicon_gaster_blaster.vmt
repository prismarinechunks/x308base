"UnlitGeneric"
{
   "$basetexture" "undertale/killicon_gaster_blaster"
   "$alphatest"   "1"
   "Proxies"
   {
      "AnimatedTexture"
      {
         "animatedtexturevar" "$basetexture"
         "animatedtextureframenumvar" "$frame"
         "animatedtextureframerate" 20
      }
   }
}